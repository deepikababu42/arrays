import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
     //   int arr[] = new int[n];
        boolean distinct = true;
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
            for(int i=0;i<n;i++){
        for(int j=i+1;j<=n-1;j++){
            if(arr[i]==arr[j]){
                distinct = false;
                break;
            }
        }
            }
        if(distinct){
            System.out.println("No distinct");
        }
        else{
            System.out.println("distinct found");
        }
    }
}
