import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        boolean descending = true;
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        for(int i=0;i<n-1;i++){
            if(arr[i]<arr[i+1]){
                descending = false;
                break;
            }
        }
        if(descending){
            System.out.println("Array in descending order");
        }
        else{
            System.out.println("Array is not in descending order");
        }
    }
}
