import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        boolean found = false;
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(arr[i]==arr[j]){
                found = true;
                break;
            }
        }
        }
        if(found){
            System.out.println("Duplicate is found");
        }
        else{
            System.out.println("Duplicate is not found");
        }
    }
}

        
    
